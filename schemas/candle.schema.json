{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlof.invalid/schemas/candle.schema.json",
  "title": "MLOF v2 normalized candle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "instrument",
    "timeframe",
    "interval_start_utc",
    "interval_end_utc",
    "source_available_at_utc",
    "open",
    "high",
    "low",
    "close",
    "tick_size",
    "open_ticks",
    "high_ticks",
    "low_ticks",
    "close_ticks",
    "source_path",
    "source_sha256",
    "source_line",
    "source_row_sha256"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "instrument": {"type": "string", "minLength": 1},
    "timeframe": {"type": "string", "minLength": 1},
    "interval_start_utc": {"type": "string", "format": "date-time"},
    "interval_end_utc": {"type": "string", "format": "date-time"},
    "source_available_at_utc": {"type": "string", "format": "date-time"},
    "open": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "high": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "low": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "close": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "tick_size": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "open_ticks": {"type": "integer"},
    "high_ticks": {"type": "integer"},
    "low_ticks": {"type": "integer"},
    "close_ticks": {"type": "integer"},
    "source_path": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_line": {"type": "integer", "minimum": 1},
    "source_row_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
