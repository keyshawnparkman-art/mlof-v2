{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlof.invalid/schemas/config.schema.json",
  "title": "MLOF v2 Milestone 1 local data configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "config_version", "min_ready_bars", "instruments", "calendar_id"],
  "properties": {
    "schema_version": {"const": 1},
    "config_version": {"type": "string", "minLength": 1},
    "min_ready_bars": {"type": "integer", "minimum": 1},
    "calendar_id": {"type": ["string", "null"]},
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrument", "tick_size"],
        "properties": {
          "instrument": {"type": "string", "minLength": 1},
          "tick_size": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
        }
      }
    }
  }
}
